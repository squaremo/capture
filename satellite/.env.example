# Copy to .env and fill in — picked up automatically on `npm start`/`npm
# run dev` via --env-file-if-exists (Node 22+, no dotenv dependency
# needed). Not committed; see ../.gitignore.

HOUSE_ID=home

# Optional: set to "true" on a satellite that's a wall-mounted panel, to
# have the served frontend render the station shell (see CLAUDE.md's
# Station entry) without needing a `?station` query param baked into the
# kiosk browser's launch URL.
STATION=

# Required for the served frontend to actually work — see README.md's
# Serving the real frontend section. Use https://, not http://.
BACKEND_URL=

# Optional: enables the Dirigera light-control endpoint. Get a token via
# `npx dirigera authenticate` (or `--gateway-IP <hub IP>` if mDNS
# discovery can't find the hub) — see README.md.
DIRIGERA_ACCESS_TOKEN=
DIRIGERA_HOST=

# Optional: enables the whisper-stream voice-input mode (local
# speech-to-text, replacing the browser's Web Speech API mic button) —
# point this at the separate `whisper` service once it's running (see
# ../whisper/README.md and ../docker-compose.satellite.yml's `whisper`
# entry, a Compose profile that's never started unless opted in). On a
# real, already-bootstrapped satellite, ../infra/enable-satellite-whisper.sh
# sets this (and enables the Compose profile) in one step — see its
# README section for the manual equivalent. Under docker-compose.satellite.yml,
# both containers share the host network namespace, so this is just its
# default: http://127.0.0.1:5001
WHISPER_URL=

# Optional: terminate HTTPS directly in this process instead of plain
# HTTP. Needed for voice capture (Web Speech API) to work once this is
# reached at its Tailscale hostname rather than localhost — see README.md.
# Mint a cert/key pair with:
#   tailscale cert --cert-file=/etc/tailscale/certs/app.crt \
#                   --key-file=/etc/tailscale/certs/app.key <this-box's-magicdns-name>
TLS_CERT_PATH=
TLS_KEY_PATH=
