# Copy to .env and fill in — picked up automatically on `npm start`/`npm
# run dev` via --env-file-if-exists (Node 22+, no dotenv dependency
# needed). Not committed; see ../.gitignore.

HOUSE_ID=home

# Required for the served frontend to actually work — see README.md's
# Serving the real frontend section. Use https://, not http://.
BACKEND_URL=

# Optional: enables the Dirigera light-control endpoint. Get a token via
# `npx dirigera authenticate` (or `--gateway-IP <hub IP>` if mDNS
# discovery can't find the hub) — see README.md.
DIRIGERA_ACCESS_TOKEN=
DIRIGERA_HOST=

# Optional: terminate HTTPS directly in this process instead of plain
# HTTP. Needed for voice capture (Web Speech API) to work once this is
# reached at its Tailscale hostname rather than localhost — see README.md.
# Mint a cert/key pair with:
#   tailscale cert --cert-file=/etc/tailscale/certs/app.crt \
#                   --key-file=/etc/tailscale/certs/app.key <this-box's-magicdns-name>
TLS_CERT_PATH=
TLS_KEY_PATH=
