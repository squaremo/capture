# Copy to .env and fill in — picked up automatically on `npm start` via
# --env-file-if-exists (Node 22+, no dotenv dependency needed). Not
# committed; see ../.gitignore. On a real satellite, these are written
# to /opt/capture-satellite/control-panel.env by
# infra/cloud-init-satellite.yaml.tpl instead, loaded via the systemd
# unit's EnvironmentFile=.

# Required — BCM GPIO numbers for the white (standby) and red (live-mic)
# LEDs. Not yet chosen for real — see designs/station-hardware.md's Open
# questions (anything free per that doc's §1 pin map works; GPIO12/13
# are worth considering for the white LED specifically, since they're
# the Pi's hardware PWM0/PWM1 pins, in case software-PWM dimming (see
# index.js) turns out too flickery once there's a real LED to look at).
CTRL_LED_WHITE_GPIO=
CTRL_LED_RED_GPIO=

# Optional overrides for the volume knob's ALSA target — defaults assume
# the WM8960 HAT (see ../designs/satellite-hardware.md).
# CTRL_MIXER_CONTROL's default is an unverified guess — run `amixer -c
# wm8960soundcard scontrols` on the real box and set this explicitly
# once known.
CTRL_MIXER_CARD=
CTRL_MIXER_CONTROL=

# Optional override for which ALSA capture substream's /proc status file
# drives the red "live-mic" LED (state: RUNNING = lit) — the default
# assumes card0/pcm0c, an unverified guess. Confirm with `cat
# /proc/asound/cards` + `ls /proc/asound/card0/` on the real box.
CTRL_MIC_STATUS_PATH=

# Optional — BCM GPIO for the third-party fan controller's control line
# (The Pi Hut's "Fan Controller for Raspberry Pi"), wired via 3
# individual jumpers rather than its header's intended rigid "first 6
# pins" mount — that would land its control line on GPIO3, which
# conflicts with the WM8960 HAT's I2C1. See index.js's file header.
# Leave unset if no fan is wired up — nothing fan-related activates.
CTRL_FAN_GPIO=
