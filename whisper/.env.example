# Copy to .env and fill in — picked up automatically on `npm start`/`npm
# run dev` via --env-file-if-exists (Node 22+, no dotenv dependency
# needed). Not committed; see ../.gitignore. Only relevant for local dev —
# the Docker image (see ../docker-compose.satellite.yml's `whisper`
# service) bakes sane defaults straight into the environment already.

# Defaults to 127.0.0.1:5001 — only ever called by the satellite process
# on the same box (see server.js), never exposed beyond localhost.
PORT=
HOST=

# Only needed if whisper.cpp/ffmpeg aren't on PATH, or the model lives
# somewhere other than the Docker image's baked-in default
# (/app/models/ggml-tiny.en.bin) — e.g. running this service directly on
# a dev machine rather than via Docker.
WHISPER_BIN_PATH=
WHISPER_MODEL_PATH=
FFMPEG_BIN_PATH=
