# Deployed as-is via git pull (see capture-sync.timer) — nothing here is
# secret. Real values live in 1Password; only OP_SERVICE_ACCOUNT_TOKEN
# (which unlocks these references) is kept off the server's git checkout,
# in /opt/capture/.env.secret.
#
# Adjust the vault/item/field names below to match what you actually
# created in 1Password, or edit the items to match these.

DATA_PATH=/data/notes
PORT=3000
HOST=0.0.0.0
TAILSCALE_SUBNET=100.64.0.0/10

ANTHROPIC_API_KEY=op://Capture/anthropic/api_key

# Optional — see designs/file-backed-storage.md. DATA_PATH only gets git
# commits at all once it's already a git repo (a one-time `git init
# /opt/capture/data/notes` on the server — this app never does that
# itself); these two only matter on top of that, to push each commit to
# a remote. A PAT on a dedicated bot account (GitHub or GitLab), not a
# personal account, scoped to just this one repo. Leave both unset for a
# local-only repo (still gets full commit history, just never pushed).
#
# DATA_PATH is deliberately a subdirectory of the mounted volume, not
# its root — satellites.json below lives at the volume's top level,
# outside the git worktree entirely, not just untracked-but-nearby. It
# was already never staged by store.js's own commits (which only ever
# `git add` an explicit items/ or favourites/ path, never the whole
# directory) — this is about not having it physically sit inside a
# directory that's cloned from and pushed to a remote at all, so a
# stray manual `git add -A` in there can't sweep it in either.
GIT_REMOTE_URL=op://Capture/git-notes/remote_url
GIT_REMOTE_TOKEN=op://Capture/git-notes/token

# Optional — enables the create_linear_task tool. Leave both unset (or
# delete this file's copy on the server) to disable it.
LINEAR_API_KEY=op://Capture/linear/api_key
LINEAR_TEAM_ID=op://Capture/linear/team_id

# Optional — Spotify Web API client-credentials, for catalog search
# behind resolve_playback (see designs/satellites.md).
SPOTIFY_CLIENT_ID=op://Capture/spotify/client_id
SPOTIFY_CLIENT_SECRET=op://Capture/spotify/client_secret

# Scopes Spotify search results to tracks actually licensed/playable in
# this market — without it, search can return an edition of a track that
# Sonos then fails to stream even though it accepted the play request
# (the failure shows up in the Sonos app, not in any log here). Set to
# the country the household's Spotify account is registered in.
SPOTIFY_MARKET=GB

# Optional — enables the control_playback tool. Points at a JSON file of
# house-id -> satellite base URL; the file itself is server-local, not
# committed (see designs/satellites.md) — create/edit it directly at
# /opt/capture/data/satellites.json, which this path resolves to inside
# the container via the same volume DATA_PATH's parent uses — a sibling
# of the DATA_PATH/notes git worktree above, not inside it.
SATELLITE_HOUSES_PATH=/data/satellites.json
