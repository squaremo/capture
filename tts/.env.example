# Copy to .env and fill in — picked up automatically on `npm start`/`npm
# run dev` via --env-file-if-exists (Node 22+, no dotenv dependency
# needed). Not committed; see ../.gitignore. Only relevant for local dev —
# the Docker image (see ../docker-compose.satellite.yml's `tts` service)
# bakes sane defaults straight into the environment already.

# Defaults to 127.0.0.1:5002 — only ever called by the satellite process
# on the same box (see server.js), never exposed beyond localhost.
PORT=
HOST=

# Which baked-in voice speaks by default (see the Dockerfile's
# PIPER_VOICES build arg for what's actually on disk, and GET /voices to
# list them at runtime) — overridable per-request too, via `voice` in
# POST /synthesize's body.
PIPER_VOICE=

# Only needed if piper isn't on PATH, or the voice models live somewhere
# other than the Docker image's baked-in default (/app/models) — e.g.
# running this service directly on a dev machine rather than via Docker.
PIPER_BIN_PATH=
PIPER_MODELS_DIR=
