# For local dev, a single flat file like this is fine. The deployed server
# instead splits this into infra/production.env (committed, op:// refs) +
# /opt/capture/.env.secret (not in git, just OP_SERVICE_ACCOUNT_TOKEN) —
# see README.md.

ANTHROPIC_API_KEY=your-anthropic-api-key

# Backend
PORT=3000
HOST=0.0.0.0
DB_PATH=./capture.db

# Optional: restrict access to Tailscale subnet (e.g. 100.64.0.0/10)
TAILSCALE_SUBNET=

# Optional: enables the create_linear_task tool. Leave both unset to disable.
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Optional: path to a house-id -> satellite base URL JSON file (e.g.
# {"home":"http://localhost:4000"}), enabling the control_playback tool.
# Deliberately NOT an env var holding the map itself — this points at a
# local file (default: backend/satellites.json, gitignored) that you
# hand-edit directly; it's re-read on every request, no restart needed
# for address changes. See designs/satellites.md.
SATELLITE_HOUSES_PATH=

# Optional: any value above can be an op:// reference instead of a literal
# secret (e.g. ANTHROPIC_API_KEY=op://vault/item/field), resolved at
# startup via a 1Password Service Account. Requires a 1Password plan that
# supports Service Accounts.
OP_SERVICE_ACCOUNT_TOKEN=
